
<% if @cart_items.any? %>
  <!-- Контейнер с информацией о корзине: общее количество и сумма -->
  <!-- Использует классы DaisyUI для стилизации (frosted glass эффект, rounded corners) -->
  <div class="space-y-3 md:space-y-4 bg-base-100/90 rounded-xl md:rounded-2xl p-4 md:p-6 backdrop-blur-sm border border-base-200">
    <!-- Блок с количеством позиций в корзине -->
    <div class="flex justify-between items-center text-base md:text-lg">
      <span class="text-base-content/70">Позиций:</span>
      <!-- Идентификатор `total-items` используется для динамического обновления через JavaScript (Turbo/AJAX) -->
      <span id="total-items" class="font-semibold"><%= @total_items %> шт.</span>
    </div>

    <!-- Визуальный разделитель (линия) -->
    <div class="divider my-1 md:my-2"></div>

    <!-- Блок с итоговой суммой к оплате -->
    <div class="flex justify-between items-center text-lg md:text-xl font-bold text-primary">
      <span>К оплате:</span>
      <!-- Идентификатор `total-price` для обновления цены без перезагрузки страницы -->
      <span id="total-price" class="text-xl md:text-2xl">
        <!-- Форматирование валюты (BYN) через хелпер Rails -->
        <%= number_to_currency(@total_price, unit: "BYN", format: "%n %u") %>
      </span>
    </div>
  </div>

  <!-- Кнопки действий: оформление заказа и очистка корзины -->
  <div class="card-actions mt-4 md:mt-6 flex flex-col gap-3" id="cart-actions">
    <!-- Ссылка на оформление брони/заказа -->
    <!-- Классы hover:scale-105 добавляют микро-анимацию при наведении для улучшения UX -->
    <%= link_to "Оформить заказ", reservation_path, class: "btn btn-primary btn-md md:btn-lg w-full shadow-lg transform transition-all hover:scale-105 active:scale-95 duration-200" %>

    <!-- Кнопка очистки корзины с ID, который слушается Stimulus/JS контроллером -->
    <button type="button" id="clear-cart-button" class="btn btn-outline btn-md md:btn-lg w-full">
      Очистить корзину
    </button>
  </div>
<% else %>
  <!-- Состояние пустой корзины: показываем заглушку и приглашение добавить товары -->
  <div class="flex flex-col items-center justify-center py-12 md:py-16">
    <!-- Иконка (SVG) для визуализации пустого состояния -->
    <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 text-primary mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
    </svg>

    <!-- Заголовок сообщения о пустой корзине -->
    <h3 class="text-xl font-semibold text-base-content/70 mb-2">Ваша корзина пуста</h3>

    <!-- Текст-подсказка с призывом к действию -->
    <p class="text-base-content/50 mb-6">Добавьте что-нибудь из нашего меню</p>

    <!-- Кнопка возвращения в меню (категории блюд) -->
    <%= link_to "Перейти в меню", menu_path, class: "btn btn-primary" %>
  </div>
<% end %>
