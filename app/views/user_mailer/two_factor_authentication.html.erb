
<!DOCTYPE html>
<html>
<head>
  <!-- Стандартные мета-теги: кодировка UTF-8 и адаптивность под мобильные -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Код подтверждения - Нежданчик</title>

  <!-- Стили (Inline CSS) -->
  <!-- В email-шаблонах запрещены внешние стили (link rel="stylesheet") -->
  <!-- поэтому мы эмулируем Tailwind CSS классы внутри тега <style>. -->
  <style>
    /* Убирает лишние отступы в Outlook/Windows Mail */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }

    /* Улучшает масштабирование картинок */
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }

    /* Убирает отступы у body для 100% ширины фона */
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; }

    /* ========================
       ЭМУЛЯЦИЯ TAILWIND CSS
       ======================== */

    /* Цвета фона */
    .bg-base-100 { background-color: #ffffff; }
    .bg-base-200 { background-color: #f5f5f5; }

    /* Основной цвет (Primary Blue) */
    .bg-primary { background-color: #3b82f6; }
    .bg-primary\/10 { background-color: #eff6ff; }
    .text-primary { color: #3b82f6; }

    /* Цвета текста */
    .text-base-content { color: #1f2937; }
    .text-base-content/60 { color: rgba(31, 41, 55, 0.6); }
    .text-base-content/80 { color: rgba(31, 41, 55, 0.8); }

    /* Размеры */
    .text-2xl { font-size: 1.5rem; line-height: 2rem; }
    .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
    .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
    .text-xs { font-size: 0.75rem; line-height: 1rem; }
    .font-bold { font-weight: 700; }

    /* Отступы */
    .p-6 { padding: 1.5rem; }
    .p-8 { padding: 2rem; }
    .mb-4 { margin-bottom: 1rem; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mt-6 { margin-top: 1.5rem; }
    .pt-4 { padding-top: 1rem; }

    /* Ширина и выравнивание */
    .w-full { width: 100%; }
    .max-w-md { max-width: 28rem; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .text-center { text-align: center; }

    /* Декор */
    .rounded-lg { border-radius: 0.5rem; }
    .rounded-2xl { border-radius: 1rem; }
    .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
    .border { border-width: 1px; }
    .border-base-300 { border-color: #e5e7eb; }
    .border-t { border-top-width: 1px; }
  </style>
</head>

<!-- Фон страницы -->
<body style="margin: 0 !important; padding: 0 !important; background-color: #f5f5f5;">

  <!-- Обертка (Main Wrapper) -->
  <table border="0" cellpadding="0" cellspacing="0" width="100%">
    <tr>
      <!-- Внешний отступ и центрирование -->
      <td bgcolor="#f5f5f5" align="center" style="padding: 20px 15px 20px 15px;" class="p-6">

        <!-- Контейнер письма (Max width: 600px) -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px;" class="max-w-md">
          <tr>
            <!-- Карточка письма (White card, shadow, radius) -->
            <td bgcolor="#ffffff" align="center" valign="top" style="border-radius: 8px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); padding: 30px;" class="bg-base-100 rounded-lg shadow-lg p-8">

              <!-- ============================
                   ШАПКА (LOGO)
                   ============================ -->
              <!-- Синяя плашка с названием ресторана -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td bgcolor="#eff6ff" align="center" style="border-radius: 16px; padding: 20px; margin-bottom: 24px;" class="bg-primary/10 rounded-2xl p-6 mb-6">
                    <h1 style="color: #3b82f6; font-size: 28px; font-weight: 700; margin: 0;" class="text-primary text-2xl font-bold">Нежданчик</h1>
                  </td>
                </tr>
              </table>

              <!-- ============================
                   ЗАГОЛОВОК
                   ============================ -->
              <h2 style="color: #1f2937; font-size: 24px; font-weight: 700; margin: 0 0 16px 0; text-align: center;" class="text-base-content text-2xl font-bold text-center mb-4">
                Двухфакторная аутентификация
              </h2>

              <p style="color: rgba(31, 41, 55, 0.8); font-size: 16px; margin: 0 0 24px 0; text-align: center;" class="text-base-content/80 text-center mb-6">
                Для завершения входа в ваш аккаунт, пожалуйста, используйте следующий код подтверждения:
              </p>

              <!-- ============================
                   ОТОБРАЖЕНИЕ КОДА (OTP)
                   ============================ -->
              <!-- Яркий блок с цифрами кода -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td bgcolor="#eff6ff" align="center" style="border-radius: 8px; padding: 20px; margin-bottom: 24px; border: 1px solid #dbeafe;" class="bg-primary/10 rounded-lg p-6 mb-6 border border-primary/20">
                    <!-- Код подставляется через Rails (@otp_code) -->
                    <!-- Больший шрифт (36px) и межбуквенный интервал (letter-spacing) для читаемости -->
                    <p style="color: #3b82f6; font-size: 36px; font-weight: 700; letter-spacing: 8px; margin: 0;" class="text-primary text-4xl font-bold">
                      <%= @otp_code %>
                    </p>
                  </td>
                </tr>
              </table>

              <!-- ============================
                   ПРЕДУПРЕЖДЕНИЕ (WARNING)
                   ============================ -->
              <p style="color: rgba(31, 41, 55, 0.6); font-size: 14px; margin: 0 0 24px 0; text-align: center;" class="text-base-content/60 text-sm text-center mb-6">
                <strong>Важно:</strong> Этот код действителен в течение 5 минут. Не передавайте его никому.
              </p>

              <!-- ============================
                   ПОДДЕРЖКА (SUPPORT)
                   ============================ -->
              <!-- Разделитель (Line) -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding: 16px 0; border-top: 1px solid #e5e7eb; margin-top: 24px;" class="border-t border-base-300 mt-6 pt-6">
                    <p style="color: rgba(31, 41, 55, 0.6); font-size: 14px; margin: 0;" class="text-base-content/60 text-sm">
                      Если вы не запрашивали этот код, пожалуйста, немедленно свяжитесь с нашей службой поддержки.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- ============================
                   ФУТЕР (FOOTER)
                   ============================ -->
              <!-- Время отправки письма -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding-top: 16px;" class="pt-4">
                    <p style="color: rgba(31, 41, 55, 0.6); font-size: 12px; margin: 0;" class="text-base-content/60 text-xs">
                      <!-- Время генерируется в момент отправки -->
                      Время: <%= Time.current.strftime("%d.%m.%Y %H:%M:%S") %><br>
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
