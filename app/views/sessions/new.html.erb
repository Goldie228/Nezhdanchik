
<!-- Страница авторизации (Login) -->
<!-- Контейнер страницы: полная высота экрана, градиентный фон, центрирование содержимого -->
<div class="min-h-screen flex items-center justify-center from-base-200 to-base-300 p-4">
  <!-- Карточка авторизации: фиксированная ширина (max-w-md), белый фон, большая тень, скругленные углы -->
  <div class="card w-full max-w-md bg-base-100 shadow-2xl rounded-2xl overflow-hidden">
    <div class="card-body p-8">

      <!-- Кнопка "Назад" (абсолютно позиционирована вверху слева) -->
      <div class="absolute top-4 left-4">
        <!-- Ссылка на главную страницу (Стрелка влево) -->
        <%= link_to "/", class: "btn btn-circle btn-ghost text-base-content/70 hover:text-base-content" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
      </div>

      <!-- Заголовок формы -->
      <div class="text-center mb-8">
        <!-- Иконка профиля пользователя в цветной плашке -->
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-full mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold">Вход в аккаунт</h1>
        <p class="text-base-content/70 mt-2">Введите свои данные для входа</p>
      </div>

      <!-- Контейнер для Flash-сообщений (изначально скрыт) -->
      <!-- Предназначен для ошибок серверной валидации или редиректа -->
      <div id="flash-alert" class="alert alert-error mb-6 shadow-lg hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="flash-message"></span>
      </div>

      <!-- Форма входа (form_with) -->
      <!-- local: true - использование обычной формы (не AJAX), novalidate - отключает встроенную валидацию браузера (используем кастомную JS) -->
      <%= form_with url: login_path, local: true, class: "space-y-5", html: { novalidate: true, id: "login-form" } do %>

        <!-- Поле: Email -->
        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">Email</span>
          </label>
          <!-- Инпут с иконкой внутри -->
          <div class="relative">
            <!-- Иконка конверта (абсолютно позиционирована слева) -->
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none z-10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <!-- Поле ввода Email (с отступом слева pl-10 для иконки) -->
            <input type="email" name="email" id="email-input" class="input input-bordered w-full pl-10" placeholder="example@mail.com" required autocomplete="email">
          </div>
          <!-- Текст ошибки валидации email -->
          <label class="label">
            <span id="email-error" class="label-text-alt text-error"></span>
          </label>
        </div>

        <!-- Поле: Пароль -->
        <div class="form-control">
          <div class="flex justify-between items-center">
            <label class="label">
              <span class="label-text font-medium">Пароль</span>
            </label>
            <!-- Ссылка на восстановление пароля (маленький текст справа) -->
            <%= link_to "Забыли пароль?", password_forgot_path, class: "label-text-alt link link-hover text-primary text-sm" %>
          </div>
          <div class="relative">
            <!-- Поле ввода Пароль (с отступом справа pr-10 для иконки) -->
            <input type="password" name="password" id="password" class="input input-bordered w-full pr-10" placeholder="Введите пароль" required autocomplete="current-password">
            <!-- Кнопка "Глаз" (togglePassword) для показа/скрытия пароля -->
            <button type="button" class="absolute top-2 right-2 p-1 text-base-content/50 hover:text-base-content transition-colors z-10" onclick="togglePassword()" aria-label="Показать/скрыть пароль">
              <!-- Иконка открытого глаза (скрыта по умолчанию) -->
              <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
              </svg>
              <!-- Иконка закрытого глаза (видима по умолчанию) -->
              <svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
          <!-- Текст ошибки валидации пароля -->
          <label class="label">
            <span id="password-error" class="label-text-alt text-error"></span>
          </label>
        </div>

        <!-- Кнопка отправки формы -->
        <div class="form-control mt-6">
          <button type="submit" class="btn btn-primary w-full text-lg font-medium shadow-lg">Войти</button>
        </div>
      <% end %>

      <!-- Футер карточки (Ссылка на регистрацию) -->
      <div class="text-center mt-6">
        <p class="text-base-content/70">
          Еще нет аккаунта?
          <!-- Ссылка на регистрацию (Primary цвет) -->
          <a href="/signup" class="link link-primary font-medium">Зарегистрируйтесь</a>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- =========================================
     JAVASCRIPT (ЛОГИКА ФОРМЫ)
     ========================================= -->
<script>
  /**
   * Функция переключения видимости пароля (Show/Hide).
   * Изменяет атрибут type инпута 'password' <-> 'text'.
   */
  function togglePassword() {
    // Находим инпут пароля
    const input = document.getElementById("password");
    // Находим иконки глаз
    const eyeOpen = document.getElementById("eye-open");
    const eyeClosed = document.getElementById("eye-closed");

    // Если пароль скрыт (type="password")
    if (input.type === "password") {
      // Показываем символы (type="text")
      input.type = "text";
      // Показываем иконку открытого глаза
      eyeOpen.classList.remove("hidden");
      // Скрываем иконку закрытого глаза
      eyeClosed.classList.add("hidden");
    } else {
      // Скрываем символы (type="password")
      input.type = "password";
      // Скрываем иконку открытого глаза
      eyeOpen.classList.add("hidden");
      // Показываем иконку закрытого глаза
      eyeClosed.classList.remove("hidden");
    }
  }

  /**
   * Инициализация после загрузки DOM
   */
  document.addEventListener('DOMContentLoaded', () => {
    // Ссылки на DOM элементы
    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email-input');
    const passwordInput = document.getElementById('password');
    const emailError = document.getElementById('email-error');
    const passwordError = document.getElementById('password-error');

    // Regex для валидации Email (простая проверка на формат email)
    const isValidEmail = (email) => {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    };

    /**
     * Функция показа ошибки (добавляет класс input-error и текст)
     */
    const showError = (input, errorElement, message) => {
      input.classList.add('input-error');
      errorElement.textContent = message;
    };

    /**
     * Функция очистки ошибки (удаляет класс input-error и текст)
     */
    const clearError = (input, errorElement) => {
      input.classList.remove('input-error');
      errorElement.textContent = '';
    };

    // Обработчик отправки формы (Submit)
    form.addEventListener('submit', (event) => {
      // Предотвращаем стандартную отправку (перезагрузку страницы)
      event.preventDefault();

      let isFormValid = true; // Флаг валидности формы

      // Сбрасываем предыдущие ошибки
      clearError(emailInput, emailError);
      clearError(passwordInput, passwordError);

      // Валидация Email
      if (!emailInput.value) {
        showError(emailInput, emailError, 'Поле Email не может быть пустым');
        isFormValid = false;
      } else if (!isValidEmail(emailInput.value)) {
        showError(emailInput, emailError, 'Пожалуйста, введите корректный адрес электронной почты');
        isFormValid = false;
      }

      // Валидация Пароль
      if (!passwordInput.value) {
        showError(passwordInput, passwordError, 'Поле Пароль не может быть пустым');
        isFormValid = false;
      }

      // Если форма валидна, отправляем её нативно
      if (isFormValid) {
        form.submit();
      }
    });

    // Обработчик потери фокуса (Blur) для Email
    emailInput.addEventListener('blur', () => {
      // Очищаем ошибку
      clearError(emailInput, emailError);

      // Если поле не пустое и формат неверен, показываем ошибку
      if (emailInput.value && !isValidEmail(emailInput.value)) {
        showError(emailInput, emailError, 'Пожалуйста, введите корректный адрес электронной почты');
      }
    });

    // Обработчик потери фокуса (Blur) для Пароль
    passwordInput.addEventListener('blur', () => {
      // Очищаем ошибку
      clearError(passwordInput, passwordError);

      // Если поле пустое, показываем ошибку
      if (!passwordInput.value) {
        showError(passwordInput, passwordError, 'Поле Пароль не может быть пустым');
      }
    });
  });

  /**
   * Автоматическое скрытие Flash-сообщений и алертов.
   * Запускается через 5 секунд после загрузки страницы.
   * Полезно для временных сообщений об успехе или ошибках.
   */
  setTimeout(() => {
    // Находим все элементы с классом .alert (DaisyUI alerts)
    const alerts = document.querySelectorAll('.alert');

    // Перебираем их и плавно скрываем (opacity: 0), затем удаляем из DOM
    alerts.forEach(alert => {
      alert.style.transition = 'opacity 0.5s';
      alert.style.opacity = '0';
      // Удаление через 500мс после начала анимации
      setTimeout(() => alert.remove(), 500);
    });
  }, 5000);
</script>
